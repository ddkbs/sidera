{
  "name": "sidera",
  "productName": "Sidera",
  "version": "0.1.0",
  "description": "Free, open-source, MCP-first visual knowledge base",
  "main": "./out/main/index.js",
  "author": "ddkbs",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3",
    "dist": "node scripts/copy-assets.cjs && electron-vite build && electron-builder --mac",
    "db:generate": "drizzle-kit generate",
    "mcp": "electron . --mcp-stdio",
    "icon": "electron scripts/make-icon.cjs",
    "predev": "node scripts/copy-assets.cjs && node scripts/brand-electron.cjs",
    "prebuild": "node scripts/copy-assets.cjs"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-details": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-mention": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.46.0",
    "mermaid": "^12.0.0",
    "motion": "^13.3.0",
    "next-themes": "^0.4.6",
    "obra-icons-react": "^1.25.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "@shadcn/react": "^0.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "thinking-orbs": "^0.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^6.0.1",
    "openai": "^7.17.0",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "app.sidera.desktop",
    "productName": "Sidera",
    "artifactName": "Sidera-${version}-${arch}.${ext}",
    "electronLanguages": [
      "en",
      "de"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Sidera",
      "artifactName": "Sidera-${version}-${arch}.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/**/*.ts",
      "!node_modules/**/README*",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/LICENSE*",
      "!node_modules/**/license*"
    ],
    "asarUnpack": [
      "**/*.node"
    ]
  }
}
