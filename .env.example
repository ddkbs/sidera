# Template only. The app reads these from the process environment (it does not auto-load .env); keep any local .env gitignored. Never commit real values.
# Optional AI provider keys; they override keys entered in Settings (which are stored
# encrypted with Electron safeStorage in <data dir>/ai-keys.bin).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Dev / automation
CANVASCL_DATA_DIR=
CANVASCL_MCP_PORT=
