{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"] }
  },
  "include": ["electron.vite.config.ts", "vitest.config.ts", "drizzle.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/renderer/src/features/canvas/history.ts", "src/renderer/src/lib/keys.ts", "src/renderer/src/features/canvas/mindmap.ts", "src/renderer/src/features/canvas/mermaidEdit.ts", "src/renderer/src/features/charts/model.ts", "tests/**/*"]
}
